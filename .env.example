# 复制为 .env 后按需修改；留空使用默认值
APP_NAME=岗位闯关式实训平台
DEBUG=true

# 留空则使用 <项目根>/data/app.db
DATABASE_URL=

# 是否打印 SQL（排查问题时临时开）
SQL_ECHO=false

# 允许的前端来源，JSON 数组
CORS_ORIGINS=["*"]

# 新建账号的默认密码（只存哈希，不落明文）
DEFAULT_PASSWORD=123456

# 上传文件落盘目录（留空 = <项目根>/data/uploads），以及单文件大小上限（MB）
UPLOAD_DIR=
MAX_UPLOAD_MB=50

# 文件存储后端：local=本地磁盘；s3=S3 协议对象存储（MinIO 也走这个）
STORAGE_BACKEND=local
# 用 MinIO 时填它的地址与账号（docker run 见 README「文件存储」）
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=training-platform
S3_REGION=us-east-1
# 是否走系统代理访问对象存储（对象存储在内网时保持 false，否则会被代理转发导致 502）
S3_USE_PROXY=false

API_PREFIX=/api
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=200
