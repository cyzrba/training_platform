.venv/
__pycache__/
*.py[cod]

# 本地数据库（可随时用 init_db 重建）
data/*.db
data/*.db-wal
data/*.db-shm

# 本地上传的文件（本地存储实现；生产环境走对象存储）
data/uploads/

# 一键启动脚本的运行时文件（后端 pid 与日志）
data/run/

# 本地数据库备份（init_db / 迁移前的手工备份）
data/backups/

# 本地配置
.env

# 工具缓存
.pytest_cache/
.ruff_cache/
.uv-cache/
*.egg-info/

# 本地下载的向量 / 重排模型权重（数 GB，按 system_config 的 model_path 引用）
# 注意必须写成 /models/：不带前导斜杠会连 app/models/ 一起忽略，新加的表模型会被静默漏提交
/models/

# 本地 RAG 中间件的持久化数据（Milvus / etcd / MinIO 卷）
deploy/data/

# 编辑器
.idea/
.vscode/
.DS_Store
